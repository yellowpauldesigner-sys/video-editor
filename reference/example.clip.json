  "format": "16:9",
  "formats": [
    "16:9",
    "9:16"
  ],
  "background": "#0b0b0f",
  "facts": [
    "A 9-second reel for the club: a claim, a number, a piece of footage.",
    "One typeface, white on near-black with one violet accent. Type comes in word by word; scenes slide up.",
    "Footage is shown as a rounded card between graphic scenes, never full bleed."
  ],
  "fonts": [],
